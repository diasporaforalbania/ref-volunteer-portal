# ==============================================================================
# REFERENDUMI — Volunteer Portal Environment Configuration
# Copy this file to '.env' for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CLIENT (Vite - Injected into Web App)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_DEFAULT_GOAL=50000

# ------------------------------------------------------------------------------
# 2. EDGE FUNCTIONS (Cloudflare Pages Functions / Wrangler / Backend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@referendum21.org
